# Copy this file to ".env" and fill in your own values.
# Spring Boot loads .env automatically (see spring.config.import in application.properties).

# MySQL database
DB_URL=jdbc:mysql://localhost:3306/HR
DB_USERNAME=root
DB_PASSWORD=

# JWT signing key: 64 hex characters. Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-64-hex-characters

# SMTP mail account
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password

# First admin account (created at first startup only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Path to the Google OAuth client secret JSON (Gmail API), see client_secret.example.json
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
